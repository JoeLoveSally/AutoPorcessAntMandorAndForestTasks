ackage="com.eg.android.AlipayGphone" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[776,2192][916,2244]" drawing-order="0" hint="" /><node index="4" text="5" resource-id="" class="android.widget.TextView" package="com.eg.android.AlipayGphone" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[912,2192][936,2244]" drawing-order="0" hint="" /><node index="5" text="人待助力" resource-id="" class="android.widget.TextView" package="com.eg.android.AlipayGphone" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[932,2192][1100,2244]" drawing-order="0" hint="" /></node></node><node index="7" text="当前对象0-14岁困境先心病患儿" resource-id="" class="android.widget.TextView" package="com.eg.android.AlipayGphone" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[92,2356][1348,2428]" drawing-order="0" hint="" /><node index="8" text="项目介绍" resource-id="" class="android.widget.TextView" package="com.eg.android.AlipayGphone" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[92,2588][1348,2688]" drawing-order="0" hint="" /><node index="9" text="" resource-id="" class="android.view.View" package="com.eg.android.AlipayGphone" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[92,2724][1348,3200]" drawing-order="0" hint=""><node index="0" text="" resource-id="" class="android.view.View" package="com.eg.android.AlipayGphone" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[92,2800][1348,3200]" drawing-order="0" hint=""><node index="0" text="山海接力：为乌蒙山女孩重启心跳" resource-id="" class="android.widget.TextView" package="com.eg.android.AlipayGphone" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[272,2800][1168,2868]" drawing-order="0" hint="" /><node index="1" text="娟娟一家生活在乌蒙山腹地的贵州省毕节市，一家七口靠几亩玉米地的微博收入维持生活。2024年，“心动万家”项目组走进了娟娟所在的校园并开展了先心病筛查，不幸的是，6岁的娟娟被确诊患有先天性心脏病。这次筛查打破了一家原本平静却拮据的生活。高额的手术费让娟娟的治疗一再搁置。命运的转机出现在同年7月，经过评估，“心动万家”项目组为娟娟打开了通往上海手术的绿色通道，专业的医疗团队为娟娟制定了细致的手术方案，医护人员的悉心照料也让这个山里的孩子感受到了温暖，小小的心脏在爱与专业救治下重获活力。" resource-id="" class="android.widget.TextView" package="com.eg.android.AlipayGphone" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[92,2908][1348,3200]" drawing-order="0" hint="" /><node index="2" text="original" resource-id="" class="android.widget.Image" package="com.eg.android.AlipayGphone" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" drawing-order="0" hint="" /><node index="3" text="2025年5月，项目组回访时，看到的娟娟气色红润，个头也蹿高了，还兴高采烈地带志愿者看自家的牛。院子里都是都是娟娟纯粹的欢乐笑声。2025年底复查时，医生宣布娟娟“完全康复”，这四字卸下了家庭一整年的重担。2026 年3月，春风又绿乌蒙山，娟娟已经背起书包走进小学校园，可以和同学们一起朗读课文。她的眼神清澈而明亮，充满了对未来的憧憬。这场跨越山海的救助，不仅挽救了一个孩子的生命，更点亮了一个大山里家庭的希望。" resource-id="" class="android.widget.TextView" package="com.eg.android.AlipayGphone" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" drawing-order="0" hint="" /><node index="4" text="original" resource-id="" class="android.widget.Image" package="com.eg.android.AlipayGphone" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" drawing-order="0" hint="" /><node index="5" text="大山里的“心”希望" resource-id="" class="android.widget.TextView" package="com.eg.android.AlipayGphone" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" drawing-order="0" hint="" /><node index="6" text="今年13岁的小马来自贵州省威宁县的一个小乡村，自幼体质孱弱，常年反复感冒，动辄40℃的高烧，经常往返卫生院就医。本不宽裕的家庭早已被医疗开支压得不堪重负，一家人全靠父亲打零工维持生计，负担十分沉重。2024年12月，小马持续高烧，被确诊为先天性心脏病，赴昆明检查后确认需手术治疗。预计五六万元的手术费用让这个普通家庭无力承担，家人四处借钱无果。小马家的困难情况被乡卫生院上报相关部门，当地相关部门随即向上海佑心基金会的，“心动万家”项目提出了申请，基金会经过评估后迅速联系了上海的定点医院为孩子开通就医绿色通道。" resource-id="" class="android.widget.TextView" package="com.eg.android.AlipayGphone" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" drawing-order="0" hint="" /><node index="7" text="2025年1月6日小马顺利入院，医院工作人员全程贴心陪同办理手续、各项检查。令人欣慰的是，手术非常顺利，小马回复状况良好，很快就可以出院了。离别时，懂事的小马认真手绘了画作赠予志愿者，真诚邀约大家再来威宁。“等你们来威宁，我请你们吃烤洋芋，我会烧火，烤出来的洋芋最香了。”小马仰着小脸，眼睛亮得像山里的星星。" resource-id="" class="android.widget.TextView" package="com.eg.android.AlipayGphone" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" drawing-order="0" hint="" /><node index="8" text="“心动万家”项目就是要帮助更多像小马一样的先心病患儿，让他们能像普通的孩子一样，可以在山坡上奔跑，可以帮家人劳动，也能等父母回家时递上一杯热水或者搬一个板凳，健康的享受童年的时光。山的那头有温暖的光，而他们的心里，也会住进一颗小小的太阳。" resource-id="" class="android.widget.TextView" package="com.eg.android.AlipayGphone" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" drawing-order="0" hint="" /><node index="9" text="original" resource-id="" class="android.widget.Image" package="com.eg.android.AlipayGphone" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" drawing-order="0" hint="" /><node index="10" text="谢谢你和小鸡一起做公益" resource-id="" class="android.widget.TextView" package="com.eg.android.AlipayGphone" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" drawing-order="0" hint="" /><node index="11" text="在蚂蚁庄园每筹集1080000颗爱心蛋，就能助力一位先心病儿童获得救助金，你的每一份爱，将由爱心企业捐赠善款，由上海仁德基金会发起，上海佑心慈善公益基金会执行。" resource-id="" class="android.widget.TextView" package="com.eg.android.AlipayGphone" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" drawing-order="0" hint="" /><node index="12" text="我们为你的爱心负责" resource-id="" class="android.widget.TextView" package="com.eg.android.AlipayGphone" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" drawing-order="0" hint="" /><node index="13" text="上海仁德基金会于2011年12月9日在上海市民政局注册成立，立足上海，辐射全国，服务社会，造福人群，推动创新，促进和谐，支持民间公益，推动公益创新，促进行业发展，努力成为公众信任、推动创新的民间公募基金会。" resource-id="" class="android.widget.TextView" package="com.eg.android.AlipayGphone" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" drawing-order="0" hint="" /><node index="14" text="上海佑心慈善基金会于2020年在上海市民政局正式注册，致力与国内领先的心科医院合作，及早发现儿童先心病人，为困境患儿提供资助和专业治疗。" resource-id="" class="android.widget.TextView" package="com.eg.android.AlipayGphone" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" drawing-order="0" hint="" /></node></node><node index="10" text="" resource-id="" class="android.view.View" package="com.eg.android.AlipayGphone" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" drawing-order="0" hint=""><node index="0" text="展开更多" resource-id="" class="android.widget.TextView" package="com.eg.android.AlipayGphone" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" drawing-order="0" hint="" /><node index="1" text="gk3Oq+c7mybgZIVyCK+Te23g9bsv7gzAga9L86196qUtoyNpkrl6brkVvgJPhi97+NBmO4uCnST+mHEXbY0rO9Zj+AO19DJfdkNRnAAAAAElFTkSuQmCC" resource-id="" class="android.widget.Image" package="com.eg.android.AlipayGphone" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" drawing-order="0" hint="" /></node><node index="11" text="项目历史进展" resource-id="" class="android.widget.TextView" package="com.eg.android.AlipayGphone" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" drawing-order="0" hint="" /><node index="12" text="本项目已累计帮助69人。" resource-id="" class="android.widget.TextView" package="com.eg.android.AlipayGphone" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" drawing-order="0" hint="" /><node index="13" text="" resource-id="" class="android.view.View" package="com.eg.android.AlipayGphone" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" drawing-order="0" hint=""><node index="0" text="" resource-id="" class="android.view.View" package="com.eg.android.AlipayGphone" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" drawing-order="0" hint=""><node index="0" text="2026-06-02由项目工作人员发布" resource-id="" class="android.widget.TextView" package="com.eg.android.AlipayGphone" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" drawing-order="0" hint="" /><node index="1" text="项目启动" resource-id="" class="android.widget.TextView" package="com.eg.android.AlipayGphone" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" drawing-order="0" hint="" /><node index="2" text="“心动万家”公益项目为0-14岁先心病儿童提供治疗费、康复费等支持。项目计划通过学校、社区提供免费先心筛查和医生与医院的社工部门获得需要救助的患儿情况，再经村、镇两级困难证明、定点医院初评、社工评估、项目部调查核实四个环节的审核对符合标准的患者进行手术补贴和资助，截至2026年4月，项目已为云南、新疆、西藏、贵州等地的45.2万余名儿童提供免费先心病筛查服务、资助774名患儿完成治疗。&#10;" resource-id="" class="android.widget.TextView" package="com.eg.android.AlipayGphone" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" drawing-order="0" hint="" /></node></node><node index="14" text="" resource-id="" class="android.view.View" package="com.eg.android.AlipayGphone" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" drawing-order="0" hint=""><node index="0" text="机构执行情况" resource-id="" class="android.widget.TextView" package="com.eg.android.AlipayGphone" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" drawing-order="0" hint="" /><node index="1" text="立项时间：" resource-id="" class="android.widget.TextView" package="com.eg.android.AlipayGphone" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" drawing-order="0" hint="" /><node index="2" text="2025年03月" resou